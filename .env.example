# Google Cloud Text-to-Speech — Latvian Standard voice (large free tier)
# 1. https://console.cloud.google.com → create/select a project
# 2. Enable “Cloud Text-to-Speech API”
# 3. APIs & Services → Credentials → Create API key
# 4. (Recommended) Restrict the key to Text-to-Speech API only

GOOGLE_TTS_API_KEY=

# Supabase (Auth + progress sync). Project Settings → API.
# After creating the project, run the files in supabase/migrations/ in order.
# Auth → Providers → Email: for local MVP you can disable “Confirm email”.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
